[
  {
    "_说明": "这是一份示例模板文件。把它另存为 invoice_templates.json 就会生效（原文件先备份）。",
    "_用法": "keywords 命中越多越优先；exclude_keywords 命中则直接跳过该模板；fields 每个键可给多条正则，按顺序取第一个命中；static 是无条件覆盖的固定值。",
    "_正则注意": "本脚本先把整份 PDF 文本压成一行（去掉所有空白）再做匹配，所以正则里不要写 \\s+ 之类的空白匹配，直接写 [^0-9]{0,40} 这种更具容错性的间隔更稳。"
  },
  {
    "name": "示例-某供应商专用版式",
    "keywords": ["某某科技有限公司", "发票号码"],
    "exclude_keywords": ["机动车销售"],
    "type": "电子普通发票",
    "fields": {
      "invoice_no": [
        "发票号码[:：]?\\s*([0-9]{8,20})",
        "票据编号[:：]?([0-9]{8,20})"
      ],
      "issue_date": [
        "开票日期[:：]?(\\d{4}年\\d{1,2}月\\d{1,2}日)",
        "日期[:：]?(\\d{4}-\\d{1,2}-\\d{1,2})"
      ],
      "buyer_name": ["购买方(?:信息)?名称[:：]?([^\\d]{2,40})"],
      "seller_name": ["销售方(?:信息)?名称[:：]?([^\\d]{2,40})"],
      "amount": ["合计金额[¥￥]?(-?[0-9][0-9,]*\\.[0-9]{2})"],
      "tax": ["合计税额[¥￥]?(-?[0-9][0-9,]*\\.[0-9]{2})"],
      "total": [
        "价税合计[^0-9¥￥]{0,40}?[¥￥]?\\s*(-?[0-9][0-9,]*\\.[0-9]{2})",
        "\\(小写\\)[¥￥]?\\s*(-?[0-9][0-9,]*\\.[0-9]{2})"
      ],
      "tax_rate": ["税率[:：]?([0-9.]+%)"]
    },
    "static": {
      "invoice_type": "电子普通发票"
    }
  },
  {
    "name": "示例-国际商务发票（英文标签）",
    "keywords": ["INVOICE", "Invoice No"],
    "exclude_keywords": [],
    "type": "国际商务发票",
    "fields": {
      "invoice_no": ["Invoice\\s*No\\.?[:：]?([A-Za-z0-9\\-]{4,30})"],
      "issue_date": ["(?:Invoice\\s*Date|Date)[:：]?([0-9]{4}[-/][0-9]{1,2}[-/][0-9]{1,2})"],
      "total": ["(?:Grand\\s*Total|Total\\s*Due|Amount\\s*Due)[:：]?[A-Z]{0,3}\\s*([0-9][0-9,]*\\.[0-9]{2})"],
      "tax": ["(?:Tax|VAT|GST)[:：]?[A-Z]{0,3}\\s*([0-9][0-9,]*\\.[0-9]{2})"]
    },
    "static": {}
  }
]
