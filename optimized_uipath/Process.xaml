  </Sequence.Variables>
<ui:InvokeCode Code="str_FileName = Path.GetFileName(in_FilePath)&#xA;int_RowsBefore = io_dt_Ledger.Rows.Count&#xA;out_Status = &quot;&quot;&#xA;Console.WriteLine(&quot;[Process] 开始处理 &quot; &amp; str_FileName)" Language="VisualBasic" DisplayName="取文件名 / 记录入账前行数">
